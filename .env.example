KEYWORDS_DB_PATH=./data/keywords.sqlite
KEYWORDS_API_PORT=8787
VITE_API_BASE_URL=http://localhost:8787

# Remote, Vercel-hosted MCPs. Set these in Vercel's encrypted environment, not
# in a committed file. /mcp is Keywords Operator; /sites-mcp is Sites Operator.
# They share the same Firebase project and auth secret. Neither exposes the local SQLite API.
KEYWORDS_REMOTE_MCP_TOKEN=
KEYWORDS_REMOTE_MCP_ALLOWED_ORIGIN=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_KEYWORD_VOLUME_API_URL=

# Remote SERP research. Brave is the default provider for the Keywords Operator;
# Serper is available only when explicitly selected and configured.
BRAVE_API_KEY=
KEYWORDS_BRAVE_API_KEY=
KEYWORDS_SERPER_API_KEY=
KEYWORDS_SERP_ENDPOINT=https://google.serper.dev/search
# SERP is a high-cost second-stage check. Fresh Firestore cache entries are reused.
KEYWORDS_SERP_CACHE_TTL_DAYS=30
KEYWORDS_SERP_MONTHLY_LIMIT=2000
KEYWORDS_SERP_SOFT_LIMIT=1500
KEYWORDS_SERP_RESERVE=500
# Treasury search uses a bounded Firestore scan to preserve backward compatibility
# without requiring composite indexes. Increase only after measuring document count/cost.
KEYWORDS_TREASURY_SEARCH_SCAN_LIMIT=2000

# Persistent execution agent. `npm run autopilot` is the only scheduler/worker owner:
# it ticks due projects, claims Operations, and launches this command.
# The command must have access to this repository's Keywords MCP/CLI and inherit KEYWORDS_AGENT_ID.
# If an argument contains {prompt}, the runner substitutes the operation prompt there; otherwise it writes the prompt to stdin.
KEYWORDS_AGENT_COMMAND=
KEYWORDS_AGENT_ARGS_JSON=[]
KEYWORDS_AGENT_ID=mcp
KEYWORDS_AGENT_CWD=
KEYWORDS_EXECUTOR_LEASE_SECONDS=900
KEYWORDS_AUTOPILOT_RUNNER_POLL_SECONDS=30
# capture_metrics compares equal seven-day periods. Daily cadence refreshes observations.
KEYWORDS_METRICS_CADENCE_HOURS=24
# Number of recent complete local GSC/GA4 imports considered when projecting to Sites Operator Firestore.
KEYWORDS_CLOUD_METRIC_IMPORT_LIMIT=4
# Confirmed Blog source mappings are mirrored into the Sites article registry before
# article-level metric projection. Keep each projection bounded; excess sources defer.
KEYWORDS_CLOUD_ARTICLE_SYNC_LIMIT=100
# Cache only non-actionable Sites optimization due checks. Ready evaluations are
# never cached, so a recorded result cannot be immediately scheduled again.
KEYWORDS_SITE_OPTIMIZATION_CHECK_MINUTES=30
# Before an existing-page edit, the query-decline workflow independently requires a
# fresh complete article-level GSC decline. These are trigger thresholds only: the
# Agent must still diagnose the real mapped page and persist one hypothesis before editing.
KEYWORDS_SITE_OPTIMIZATION_PROBE_MINUTES=60
KEYWORDS_SITE_OPTIMIZATION_MAX_SNAPSHOT_AGE_HOURS=48
KEYWORDS_SITE_OPTIMIZATION_MIN_IMPRESSIONS=100
KEYWORDS_SITE_OPTIMIZATION_MIN_PREVIOUS_CLICKS=5
KEYWORDS_SITE_OPTIMIZATION_CLICK_DROP_RATIO=0.30
KEYWORDS_SITE_OPTIMIZATION_POSITION_DROP=2
KEYWORDS_SITE_OPTIMIZATION_CTR_DROP=0.01
# Traffic-aware evaluation waits use baseline traffic normalized to seven days.
# High traffic => at least 14 days; medium => 21; lower traffic => 28.
# These thresholds change only the minimum wait, never the success/failure verdict.
KEYWORDS_OPTIMIZATION_FAST_IMPRESSIONS_7D=500
KEYWORDS_OPTIMIZATION_FAST_CLICKS_7D=20
KEYWORDS_OPTIMIZATION_MEDIUM_IMPRESSIONS_7D=100
KEYWORDS_OPTIMIZATION_MEDIUM_CLICKS_7D=5
# GSC query feedback is a separate low-priority research Operation. The Operator
# compares bounded saved top-query sets, then the Agent runs the shared Ads-first
# pipeline and may save selected evidence-backed candidates to Treasury.
KEYWORDS_SITE_QUERY_FEEDBACK_CHECK_MINUTES=60
KEYWORDS_SITE_QUERY_MIN_IMPRESSIONS=20
KEYWORDS_SITE_QUERY_MIN_GROWTH_RATIO=1.5
KEYWORDS_SITE_QUERY_FEEDBACK_LIMIT=20
KEYWORDS_SITE_QUERY_MAX_SERP_CHECKS=5

# Real Blog repository/artifact root. Article writes are rejected without this root.
KEYWORDS_BLOG_ROOT=
# Multi-site Blog registry root (.seo-autopilot/sites.json and integration/sites/*.json).
KEYWORDS_BLOG_WORKSPACE_ROOT=
# Legacy single-site root is accepted only for this exact bound Blog site.
KEYWORDS_BLOG_SITE_ID=
# Relative directory / extension used when a Blog source mapping does not already provide a source_ref.
KEYWORDS_BLOG_ARTICLE_DIR=content
KEYWORDS_BLOG_ARTICLE_EXTENSION=.md
# Required for local completion. Example: npm run build
KEYWORDS_BLOG_BUILD_COMMAND=
KEYWORDS_BUILD_TIMEOUT_MS=180000
# Opt-in Git delivery for verified artifacts. The allowlist contains Blog site IDs
# from .seo-autopilot/sites.json; leave empty to allow every connected site.
# Only the verified artifact path is staged and committed.
KEYWORDS_AUTO_GIT_PUSH=0
KEYWORDS_AUTO_GIT_PUSH_SITES=
KEYWORDS_AUTO_GIT_PUSH_REMOTE=origin
# Empty means the current checked-out branch. Set explicitly for unattended use.
KEYWORDS_AUTO_GIT_PUSH_BRANCH=
# Revision/no-progress safety boundaries before escalating to a human decision.
KEYWORDS_MAX_ARTICLE_REVISIONS=3
KEYWORDS_MAX_NO_PROGRESS_RETRIES=2

# Google Ads KeywordPlanIdeaService
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_LANGUAGE_ID=
GOOGLE_ADS_GEO_TARGET_IDS=
# Optional Google Ads Keyword Planner proxy fallback when direct OAuth is unavailable.
GOOGLE_ADS_KEYWORD_VOLUME_API_URL=
# Optional OAuth refresh flow (credentials remain environment-only).
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Google Search Console Search Analytics. Used by research.gsc and metrics.capture.
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# Service-account key path. The same key can be used for GSC and GA4 when the
# service account has access to both properties. Key material is never persisted.
GOOGLE_APPLICATION_CREDENTIALS=
# Preferred for long-lived local/API operation; access tokens are minted at runtime and never stored.
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=

# Google Analytics Data API. The exact property ID belongs in Sites registry
# (`sites.ga4PropertyId`), not in a global per-process property variable.
# Credentials are environment-only. Dedicated Analytics credentials take priority;
# shared GOOGLE_OAUTH_* or GOOGLE_APPLICATION_CREDENTIALS are valid fallbacks.
GOOGLE_ANALYTICS_ACCESS_TOKEN=
GOOGLE_ANALYTICS_REFRESH_TOKEN=
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
# Normally leave this unset. It exists for compatible test/proxy environments.
GOOGLE_ANALYTICS_DATA_API_ENDPOINT=

# Optional shared Google OAuth token fallback for Ads / Search Console / Analytics.
# The underlying grant still needs the scopes required by each API.
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public web and sitemap fetches block localhost/private IP targets unless explicitly overridden.
KEYWORDS_ALLOW_PRIVATE_FETCH=0

# Compatibility fallback only. Direct GA4 Data API measurement imports are preferred.
# If no complete direct GA4 import exists for a site, Sites Operator may still read
# the legacy analytics-dashboard snapshot from this path.
KEYWORDS_ANALYTICS_FILE=analytics-dashboard/data/latest.json
