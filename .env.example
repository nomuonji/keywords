KEYWORDS_DB_PATH=./data/keywords.sqlite
KEYWORDS_API_PORT=8787
VITE_API_BASE_URL=http://localhost:8787

# Remote, Vercel-hosted MCP. Set these in Vercel's encrypted environment, not
# in a committed file. This MCP exposes only keyword research and the
# Firestore-backed keyword treasury; it never exposes the local SQLite API.
KEYWORDS_REMOTE_MCP_TOKEN=
KEYWORDS_REMOTE_MCP_ALLOWED_ORIGIN=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_KEYWORD_VOLUME_API_URL=

# Persistent execution agent. `npm run autopilot` is the only scheduler/worker owner:
# it ticks due projects, claims Operations, and launches this command.
# The command must have access to this repository's Keywords MCP/CLI and inherit KEYWORDS_AGENT_ID.
# If an argument contains {prompt}, the runner substitutes the operation prompt there; otherwise it writes the prompt to stdin.
KEYWORDS_AGENT_COMMAND=
KEYWORDS_AGENT_ARGS_JSON=[]
KEYWORDS_AGENT_ID=mcp
KEYWORDS_AGENT_CWD=
KEYWORDS_EXECUTOR_LEASE_SECONDS=900
KEYWORDS_AUTOPILOT_RUNNER_POLL_SECONDS=30

# Real Blog repository/artifact root. Article writes are rejected without this root.
KEYWORDS_BLOG_ROOT=
# Multi-site Blog registry root (.seo-autopilot/sites.json and integration/sites/*.json).
KEYWORDS_BLOG_WORKSPACE_ROOT=
# Legacy single-site root is accepted only for this exact bound Blog site.
KEYWORDS_BLOG_SITE_ID=
# Relative directory / extension used when a Blog source mapping does not already provide a source_ref.
KEYWORDS_BLOG_ARTICLE_DIR=content
KEYWORDS_BLOG_ARTICLE_EXTENSION=.md
# Required for local completion. Example: npm run build
KEYWORDS_BLOG_BUILD_COMMAND=
KEYWORDS_BUILD_TIMEOUT_MS=180000
# Opt-in Git delivery for verified artifacts. The allowlist contains Blog site IDs
# from .seo-autopilot/sites.json; leave empty to allow every connected site.
# Only the verified artifact path is staged and committed.
KEYWORDS_AUTO_GIT_PUSH=0
KEYWORDS_AUTO_GIT_PUSH_SITES=
KEYWORDS_AUTO_GIT_PUSH_REMOTE=origin
# Empty means the current checked-out branch. Set explicitly for unattended use.
KEYWORDS_AUTO_GIT_PUSH_BRANCH=
# Revision/no-progress safety boundaries before escalating to a human decision.
KEYWORDS_MAX_ARTICLE_REVISIONS=3
KEYWORDS_MAX_NO_PROGRESS_RETRIES=2

# SERP research (Serper-compatible by default)
KEYWORDS_SERPER_API_KEY=
KEYWORDS_SERP_ENDPOINT=https://google.serper.dev/search

# Google Ads KeywordPlanIdeaService
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_LANGUAGE_ID=
GOOGLE_ADS_GEO_TARGET_IDS=
# Optional Google Ads Keyword Planner proxy fallback when direct OAuth is unavailable.
GOOGLE_ADS_KEYWORD_VOLUME_API_URL=
# Optional OAuth refresh flow (credentials remain environment-only).
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# Google Search Console Search Analytics. Used by research.gsc and metrics.capture.
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
GOOGLE_SEARCH_CONSOLE_SITE_URL=
# Existing service-account key path; the key remains outside SQLite and source metadata.
GOOGLE_APPLICATION_CREDENTIALS=
# Preferred for long-lived local/API operation; access tokens are minted at runtime and never stored.
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=

# Optional shared Google OAuth token fallback for Ads / Search Console
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public web and sitemap fetches block localhost/private IP targets unless explicitly overridden.
KEYWORDS_ALLOW_PRIVATE_FETCH=0

# Optional: relative to Blog root, or an absolute path. Shared dashboard snapshot.
KEYWORDS_ANALYTICS_FILE=analytics-dashboard/data/latest.json
