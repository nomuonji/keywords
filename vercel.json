{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    { "source": "/mcp/health", "destination": "/api/mcp" },
    { "source": "/sites-mcp", "destination": "/api/sites-mcp" },
    { "source": "/sites-mcp/health", "destination": "/api/sites-mcp" },
    { "source": "/oauth/(.*)", "destination": "/api/mcp" },
    { "source": "/.well-known/(.*)", "destination": "/api/mcp" }
  ]
}
